# MySQL 配置
[mysql]
host = 127.0.0.1
port = 3306
user = root
password = YOUR_MYSQL_PASSWORD
database = df_rag_v4

# MongoDB 配置
[mongodb]
mongo_url = mongodb://localhost:27017/
user = admin
mongo_db_name = rag_doc_data
mongo_collection_name = doc_url

# Redis 配置
[redis]
host = 127.0.0.1
port = 6379
password =
db = 0

# Redis 向量缓存配置
[redis_vector_cache]
index_name = rag_query_vector_cache
vector_dim = 1024
similarity_threshold = 0.95
temporary_ttl = 86400
formal_ttl = 604800
hot_threshold = 3
max_cache_size = 100000

# Milvus 配置
[milvus]
host = 127.0.0.1
port = 19530
database_name = df_finance_rag_v4
collection_name = df_announce_chunks

# LLM 配置
[llm]
model = glm-5.3
dashscope_api_key = YOUR_DASHSCOPE_API_KEY
dashscope_base_url = https://your-llm-endpoint/v1
table_llm_models = glm-5.3, qwen-max, deepseek-v3
table_enhance_enabled = true
table_llm_timeout = 30

# 检索参数配置
[retrieval]
parent_chunk_size = 1200
child_chunk_size = 300
chunk_overlap = 60
retrieval_k = 100
rerank_k = 5
candidate_m = 5

# 设备配置：cpu / cuda
[device]
device = cuda

# 日志配置
[logger]
log_file = ./app.log

# 应用配置
[app]
valid_sources = ["重大事项", "风险提示", "融资公告", "持股变动", "信息变更"]
customer_service_phone = 12345678
